roles:
{%- for vault in vaults %}
  - address: "{{ vault.underlying }}" # approve {{ vault.symbol }} for {{ vault.name }}
    functions:
      - signature: "function approve(address spender, uint256 amount)"
        execution_options: "none"
        params:
          - name: spender
            param_type: "static"
            operator: "equal_to"
            value: "{{ vault.address }}"
            value_type: "address"
          - name: amount
            param_type: "static"
            operator: "pass"
{%- endfor %}

{%- for vault in vaults %}
  - address: "{{ vault.address }}" # MetaMorpho vault: {{ vault.name }}
    functions:
      - signature: "function deposit(uint256 assets, address receiver)"
        execution_options: "none"
        params:
          - name: assets
            param_type: "static"
            operator: "pass"
          - name: receiver
            param_type: "static"
            operator: "equal_to_avatar"

      - signature: "function mint(uint256 shares, address receiver)"
        execution_options: "none"
        params:
          - name: shares
            param_type: "static"
            operator: "pass"
          - name: receiver
            param_type: "static"
            operator: "equal_to_avatar"

      - signature: "function withdraw(uint256 assets, address receiver, address owner)"
        execution_options: "none"
        params:
          - name: assets
            param_type: "static"
            operator: "pass"
          - name: receiver
            param_type: "static"
            operator: "equal_to_avatar"
          - name: owner
            param_type: "static"
            operator: "equal_to_avatar"

      - signature: "function redeem(uint256 shares, address receiver, address owner)"
        execution_options: "none"
        params:
          - name: shares
            param_type: "static"
            operator: "pass"
          - name: receiver
            param_type: "static"
            operator: "equal_to_avatar"
          - name: owner
            param_type: "static"
            operator: "equal_to_avatar"
{%- endfor %}
