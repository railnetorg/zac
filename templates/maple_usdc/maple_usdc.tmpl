{#-
  Maple Pool (ERC-4626-style) — deposit / requestRedeem / redeem

  Required template params:
    pool_address        — address of the Maple Pool contract
    deposit_assets[]    — list of { address, symbol } that may be approved
                          and deposited; in practice usually one (e.g. USDC)

  Mirrors railnet's `maple_usdc.yaml`. Receiver / owner on all three
  exit-side functions are pinned to the avatar (Safe), preventing the role
  member from routing shares to a foreign address.
-#}
roles:
{%- for asset in deposit_assets %}
  - address: "{{ asset.address }}" # approval for {{ asset.symbol }}
    functions:
      - signature: "function approve(address spender, uint256 amount)"
        execution_options: "none"
        params:
          - name: spender
            param_type: "static"
            operator: "equal_to"
            value: "{{ pool_address }}"
            value_type: "address"
          - name: amount
            param_type: "static"
            operator: "pass"
{%- endfor %}

  - address: "{{ pool_address }}"
    functions:
      - signature: "function deposit(uint256 assets, address receiver)"
        execution_options: "none"
        params:
          - name: assets
            param_type: "static"
            operator: "pass"
          - name: receiver
            param_type: "static"
            operator: "equal_to_avatar"

      - signature: "function requestRedeem(uint256 shares, address owner)"
        execution_options: "none"
        params:
          - name: shares
            param_type: "static"
            operator: "pass"
          - name: owner
            param_type: "static"
            operator: "equal_to_avatar"

      - signature: "function redeem(uint256 shares, address receiver, address owner)"
        execution_options: "none"
        params:
          - name: shares
            param_type: "static"
            operator: "pass"
          - name: receiver
            param_type: "static"
            operator: "equal_to_avatar"
          - name: owner
            param_type: "static"
            operator: "equal_to_avatar"
