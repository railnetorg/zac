{#-
  Ondo USDY — subscribe / redeem through the USDY Instant Manager.

  The USDY Instant Manager mints USDY against a payment asset and redeems
  USDY back into it, at the price of Ondo's USDY oracle. It is
  canonical-per-chain, so it is resolved from aliases.ondo_usdy.subscriber
  inside the template — NOT passed as a param. The subscriber alias entry
  must declare:
    address     — USDY Instant Manager contract address
    share_token — USDY token address (kept in the Ondo namespace because
                  USDY is Ondo-specific, not a token any other protocol
                  would reference)

  The Instant Manager only serves callers registered in Ondo's ID registry
  for USDY: the Safe must be onboarded with Ondo for the calls to succeed.

  Required template params:
    payment_assets — list of token alias keys the Safe is permitted to
                     subscribe / redeem with (e.g. ["USDC"]). Each entry
                     resolved via aliases.tokens[<key>] — missing ⇒
                     render-time error.

  Resolved from aliases (NOT params):
    aliases.ondo_usdy.subscriber.address     — USDY Instant Manager
    aliases.ondo_usdy.subscriber.share_token — USDY address
    aliases.tokens[<asset>]                  — payment-asset address per entry

  Output shape:
    - One approve role per token (USDY + each payment_asset), with
      spender = the Instant Manager (single, equal_to).
    - One subscribe / redeem role on the Instant Manager, with `asset`
      pinned to oneOf(payment_assets).
-#}
{%- from "_macros/common.tmpl" import approve -%}
{%- set sub = aliases.ondo_usdy.subscriber -%}
roles:
  {{ approve(sub.share_token, sub.address) | indent(2) }}
{%- for asset in payment_assets %}
  {{ approve(aliases.tokens[asset], sub.address) | indent(2) }}
{%- endfor %}

  - address: "{{ sub.address }}"
    functions:
      - signature: "function subscribe(address asset, uint256 amount, uint256 minAmountOut)"
        execution_options: "none"
        params:
          - name: asset
            param_type: "static"
            operator: "oneOf"
            values:
              {%- for asset in payment_assets %}
              - "{{ aliases.tokens[asset] }}"
              {%- endfor %}
            value_type: "address"
          - name: amount
            param_type: "static"
            operator: "pass"
          - name: minAmountOut
            param_type: "static"
            operator: "pass"

      - signature: "function redeem(uint256 shareAmount, address asset, uint256 minAmountOut)"
        execution_options: "none"
        params:
          - name: shareAmount
            param_type: "static"
            operator: "pass"
          - name: asset
            param_type: "static"
            operator: "oneOf"
            values:
              {%- for asset in payment_assets %}
              - "{{ aliases.tokens[asset] }}"
              {%- endfor %}
            value_type: "address"
          - name: minAmountOut
            param_type: "static"
            operator: "pass"
