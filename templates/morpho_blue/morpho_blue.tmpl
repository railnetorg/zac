{#-
  Morpho Blue — supply / withdraw the loan token, and the collateral and
  borrow side of the same markets.

  Singleton is canonical-per-chain, resolved from
  aliases.morpho_blue.singleton (NOT a param). Markets are referenced by
  alias KEY under aliases.morpho_blue.markets. Each market entry must
  declare the full MarketParams tuple:
    loan_token, collateral_token, oracle, irm, lltv
  All five are resolved with no existence guard — a missing key (or a
  missing field on the resolved entry) throws at render time.

  Approves are AUTO-DERIVED from the union of markets[*].loan_token and
  markets[*].collateral_token, deduplicated. The Safe only needs approve
  scopes for tokens it can actually hand to the singleton — it supplies the
  loan token and posts the collateral token — and the markets list already
  names both, so there is no separate `deposit_assets` param. Approves go
  straight to the addresses pulled from the alias entries, bypassing
  aliases.tokens (the alias registry is already the ground truth).

  Required template params:
    markets — list of market alias keys, e.g.
              ["usdc_cbbtc_86", "usdc_wbtc_86", "usdc_wsteth_86"].
              Each entry resolved via aliases.morpho_blue.markets[<key>].

  Resolved from aliases (NOT params):
    aliases.morpho_blue.singleton          — Morpho Blue singleton
    aliases.morpho_blue.markets[<key>]     — MarketParams tuple per market

  Output shape:
    - One approve role per UNIQUE token across both roles, with
      spender = equal_to singleton.
    - One role on the singleton scoping six functions, each with
      marketParams pinned to the configured markets (see the shared
      `market_params` macro). `onBehalf` is pinned to the avatar on all
      six; `receiver` is pinned to the avatar on `withdraw`, `borrow` and
      `withdrawCollateral`, so borrowed assets and released collateral can
      only land back in the Safe.

  Assets vs shares — entry directions pin it, exit directions do not.
  Morpho itself requires exactly one of `assets` and `shares` to be zero
  (`UtilsLib.exactlyOneZero`, Morpho.sol), so pinning one is not about
  preventing an invalid combination; the protocol already does that. It is
  about which of the two the caller has to state.

    Entry — `supply` and `borrow` pin `shares = 0`. Shares-mode would mean
            "deposit (or borrow) whatever assets correspond to N shares",
            so the amount entering or the debt taken on would not be the
            number the caller wrote.
    Exit  — `withdraw` and `repay` leave both `pass`. Shares-mode is the
            only way to leave a position exactly: assets-mode has to name a
            figure derived from an index that moves between the read and the
            transaction, so it either leaves dust or overshoots and reverts.
            Both calls can only unwind the Safe's own position, so admitting
            shares-mode costs nothing. Do not pin these to zero for symmetry
            with the entry pair — it would make a clean exit impossible.

  Length-1 optimization: when `markets` has exactly one entry, the
  marketParams scoping emits a bare `matches` (no `or` wrapper).
  Required because `or` with < 2 conditions is rejected at apply time
  (action/apply/toSdkTargets.ts:67).
-#}
{%- from "_macros/common.tmpl" import approve -%}
{%- from "_macros/morpho.tmpl" import market_params -%}
{%- set singleton = aliases.morpho_blue.singleton -%}
{#- Pass 1: collect the unique tokens the Safe hands to the singleton, across
    both roles. A token that is the loan asset of one configured market and
    the collateral of another must still get exactly one approve entry. -#}
{%- set approved_tokens = [] -%}
{%- for key in markets -%}
  {%- set market = aliases.morpho_blue.markets[key] -%}
  {%- if market.loan_token not in approved_tokens -%}
    {%- set _ = approved_tokens.push(market.loan_token) -%}
  {%- endif -%}
  {%- if market.collateral_token not in approved_tokens -%}
    {%- set _ = approved_tokens.push(market.collateral_token) -%}
  {%- endif -%}
{%- endfor -%}
roles:
{%- for token in approved_tokens %}
  {{ approve(token, singleton) | indent(2) }}
{%- endfor %}

  - address: "{{ singleton }}"
    functions:
      - signature: "function supply((address loanToken, address collateralToken, address oracle, address irm, uint256 lltv) marketParams, uint256 assets, uint256 shares, address onBehalf, bytes data)"
        execution_options: "none"
        params:
          - name: marketParams
            param_type: "tuple"
            {{ market_params(markets, aliases) | indent(12) }}
          - name: assets
            param_type: "static"
            operator: "pass"
          - name: shares
            param_type: "static"
            operator: "equal_to"
            value: "0"
            value_type: "uint256"
          - name: onBehalf
            param_type: "static"
            operator: "equal_to_avatar"
          - name: data
            param_type: "dynamic"
            operator: "pass"

      - signature: "function withdraw((address loanToken, address collateralToken, address oracle, address irm, uint256 lltv) marketParams, uint256 assets, uint256 shares, address onBehalf, address receiver)"
        execution_options: "none"
        params:
          - name: marketParams
            param_type: "tuple"
            {{ market_params(markets, aliases) | indent(12) }}
          - name: assets
            param_type: "static"
            operator: "pass"
          - name: shares
            param_type: "static"
            operator: "pass"
          - name: onBehalf
            param_type: "static"
            operator: "equal_to_avatar"
          - name: receiver
            param_type: "static"
            operator: "equal_to_avatar"

      - signature: "function supplyCollateral((address loanToken, address collateralToken, address oracle, address irm, uint256 lltv) marketParams, uint256 assets, address onBehalf, bytes data)"
        execution_options: "none"
        params:
          - name: marketParams
            param_type: "tuple"
            {{ market_params(markets, aliases) | indent(12) }}
          - name: assets
            param_type: "static"
            operator: "pass"
          - name: onBehalf
            param_type: "static"
            operator: "equal_to_avatar"
          - name: data
            param_type: "dynamic"
            operator: "pass"

      - signature: "function withdrawCollateral((address loanToken, address collateralToken, address oracle, address irm, uint256 lltv) marketParams, uint256 assets, address onBehalf, address receiver)"
        execution_options: "none"
        params:
          - name: marketParams
            param_type: "tuple"
            {{ market_params(markets, aliases) | indent(12) }}
          - name: assets
            param_type: "static"
            operator: "pass"
          - name: onBehalf
            param_type: "static"
            operator: "equal_to_avatar"
          - name: receiver
            param_type: "static"
            operator: "equal_to_avatar"

      - signature: "function borrow((address loanToken, address collateralToken, address oracle, address irm, uint256 lltv) marketParams, uint256 assets, uint256 shares, address onBehalf, address receiver)"
        execution_options: "none"
        params:
          - name: marketParams
            param_type: "tuple"
            {{ market_params(markets, aliases) | indent(12) }}
          - name: assets
            param_type: "static"
            operator: "pass"
          - name: shares
            param_type: "static"
            operator: "equal_to"
            value: "0"
            value_type: "uint256"
          - name: onBehalf
            param_type: "static"
            operator: "equal_to_avatar"
          - name: receiver
            param_type: "static"
            operator: "equal_to_avatar"

      - signature: "function repay((address loanToken, address collateralToken, address oracle, address irm, uint256 lltv) marketParams, uint256 assets, uint256 shares, address onBehalf, bytes data)"
        execution_options: "none"
        params:
          - name: marketParams
            param_type: "tuple"
            {{ market_params(markets, aliases) | indent(12) }}
          - name: assets
            param_type: "static"
            operator: "pass"
          - name: shares
            param_type: "static"
            operator: "pass"
          - name: onBehalf
            param_type: "static"
            operator: "equal_to_avatar"
          - name: data
            param_type: "dynamic"
            operator: "pass"
